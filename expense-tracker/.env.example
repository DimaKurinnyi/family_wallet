# Postgres, по которому работает приложение. На Vercel это pooled-строка
# Neon (в ней есть -pooler), иначе serverless-функции быстро выедают лимит
# соединений.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"

# Строка для миграций — прямая, без пула. Пулер работает в режиме транзакций
# и не даёт сессионных блокировок, на которых держится prisma migrate.
# В Neon это DATABASE_URL_UNPOOLED. Если не задана, миграции пойдут по
# DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Секрет для подписи JWT. Сгенерировать: openssl rand -base64 32
JWT_SECRET=""

# ── Отправка приглашений по почте ──────────────────────────────────────
# Настраивается ОДИН из двух провайдеров. Без них письма не шлются:
# приглашение всё равно создаётся, а ссылку владелец копирует кнопкой.

# Вариант 1 — EmailJS. Домен не нужен, письма уходят с вашей же почты.
# Ключи берутся в дашборде EmailJS. Приватный ключ обязателен: без него
# сервис не принимает запросы не из браузера, а из браузера слать нельзя —
# ключи уехали бы к пользователю.
# В шаблоне EmailJS должны быть переменные: to_email, inviter_name,
# wallet_name, invite_link. Поле «To email» в шаблоне — {{to_email}}.
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""

# Вариант 2 — Resend. Нужен свой домен с DNS-записями, зато письма уходят
# от имени сервиса. MAIL_FROM должен быть на подтверждённом домене.
RESEND_API_KEY=""
MAIL_FROM="Expense Tracker <invites@yourdomain.com>"
