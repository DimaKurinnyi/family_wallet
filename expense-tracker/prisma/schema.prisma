// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  currency      String         @default("USD")
  wallets       Wallet[]       @relation("UserWallets")
  createdAt     DateTime       @default(now())
  walletMembers WalletMember[]
  sentInvites   WalletInvite[] @relation("SentInvites")
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
}

model Wallet {
  id           String         @id @default(cuid())
  name         String
  type         WalletType // "personal" or "shared"
  // Владелец есть у любого кошелька, включая общий: он управляет
  // участниками, переименованием и удалением.
  ownerId      String
  owner        User           @relation("UserWallets", fields: [ownerId], references: [id])
  members      WalletMember[]
  invites      WalletInvite[]
  transactions Transaction[]
  createdAt    DateTime       @default(now())
}

// Участники общего кошелька, кроме владельца: он определяется Wallet.ownerId.
model WalletMember {
  id        String   @id @default(cuid())
  userId    String
  walletId  String
  user      User     @relation(fields: [userId], references: [id])
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Без этого одного человека можно было добавить в кошелёк дважды.
  @@unique([walletId, userId])
}

model WalletInvite {
  id          String       @id @default(cuid())
  walletId    String
  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  // Приглашение привязано к почте: ссылку можно переслать, но принять её
  // сможет только тот, на кого она выписана.
  email       String
  token       String       @unique
  status      InviteStatus @default(pending)
  invitedById String
  invitedBy   User         @relation("SentInvites", fields: [invitedById], references: [id])
  createdAt   DateTime     @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  @@index([walletId])
}

model Icon {
  id         String     @id @default(cuid())
  name       String
  type       IconType
  categories Category[]

  @@unique([name, type])
}

model Category {
  id           String        @id @default(cuid())
  name         String
  iconId       String
  type         CategoryType
  // Для какой стороны операции годится категория. both — и туда и туда:
  // «Подарки» можно и получить, и подарить.
  flow         CategoryFlow  @default(expense)
  icon         Icon          @relation(fields: [iconId], references: [id])
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  transactions Transaction[]
  createdAt    DateTime      @default(now())

  @@unique([name, userId])
}

model Transaction {
  id         String          @id @default(cuid())
  type       TransactionType
  amount     Float
  // Валюта, в которой операцию ввели. Пересчёт делается при показе по
  // текущему курсу, а исходная сумма остаётся неизменной.
  currency   String          @default("USD")
  comment    String?
  categoryId String?
  category   Category?       @relation(fields: [categoryId], references: [id])
  walletId   String
  wallet     Wallet          @relation(fields: [walletId], references: [id])
  userId     String // кто совершил транзакцию
  user       User            @relation(fields: [userId], references: [id])
  createdAt  DateTime        @default(now())
}

// Последние известные курсы к доллару. Нужны как запас: если внешний
// сервис недоступен, показываем сохранённые и честно пишем их дату.
model ExchangeRate {
  base      String
  currency  String
  rate      Float
  updatedAt DateTime @updatedAt

  @@id([base, currency])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  // Important for credentials login (email+password)
  hashedPassword String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

enum WalletType {
  personal
  shared
}

enum TransactionType {
  income
  expense
}

enum CategoryType {
  system
  custom
}

enum InviteStatus {
  pending
  accepted
  revoked
}

enum CategoryFlow {
  income
  expense
  both
}

enum IconType {
  system
  custom
}
